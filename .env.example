# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit ไฟล์ .env ขึ้น git)

# ฐานข้อมูล MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=shopuser
DB_PASSWORD=เปลี่ยนเป็นรหัสผ่านจริง
DB_NAME=kaiklomshop

# กุญแจเข้ารหัส username/password สต็อกไอดีเกม (ห้ามลืม ห้ามหาย ห้ามเปลี่ยนหลังมีข้อมูลแล้ว)
# สร้างด้วยคำสั่ง: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_KEY=

PORT=4173
NODE_ENV=production
